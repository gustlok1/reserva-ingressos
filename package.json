{
  "name": "reserva-ingressos",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "db:setup": "npm run db:setup -w backend",
    "db:reset": "npm run db:reset -w backend",
    "test": "npm test --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "typescript": "~6.0.2"
  }
}
